# These go in Netlify: Project configuration → Environment variables
# (For local testing only, copy this file to .env)

# ===== General =====
BASE_URL=https://homelist.netlify.app
BRAND_NAME=كرت الطلبات
PRICE_USD=2
TRIAL_DAYS=7
ADMIN_TOKEN=long-random-password-for-admin
CRON_SECRET=another-random-string

# ===== Apple Wallet =====
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_PASS_TYPE_ID=pass.com.yourname.homelist
# Paste the full file content (-----BEGIN ... END-----). Base64 also works.
APPLE_SIGNER_CERT=
APPLE_SIGNER_KEY=
APPLE_WWDR=
APPLE_SIGNER_KEY_PASSPHRASE=

# ===== WhatsApp Cloud API =====
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=any-word-you-choose
WA_APP_SECRET=
# Bot number, digits only with country code, e.g. 15551234567
WA_BOT_NUMBER=

# ===== Stripe =====
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== Google Wallet (later) =====
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_SUFFIX=home_list
# Paste the whole service-account JSON
GOOGLE_SERVICE_ACCOUNT=

# ===== Optional: smarter item splitting with Claude =====
ANTHROPIC_API_KEY=
